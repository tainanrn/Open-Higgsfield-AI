# Copy to .env.local (never commit .env.local) and fill in at least one key.

# Free: Hugging Face token (https://huggingface.co/settings/tokens).
# Needs the "Make calls to Inference Providers" permission.
# Free accounts get a small monthly inference credit.
HUGGINGFACE_API_KEY=

# Paid: Muapi key (https://muapi.ai). Enables Nano Banana Pro Edit up to 4K,
# plus the video, lip sync and cinema studios.
MUAPI_API_KEY=
